# Copy to .env and fill in. .env is gitignored.

# --- Secrets ---
ANTHROPIC_API_KEY=sk-ant-...
TELNYX_API=KEY...

# --- Set automatically by scripts/start.sh (the cloudflared URL) ---
# PUBLIC_URL=https://xxxx.trycloudflare.com

# --- Optional overrides (see config.py for all knobs) ---
MODEL=claude-haiku-4-5
WHISPER_MODEL=small.en
WHISPER_COMPUTE=int8
TTS_ENGINE=kokoro
KOKORO_VOICE=af_heart
AGENT_NUMBER=+15551234567
PORT=8000

# --- Security / ops (optional) ---
# DEBUG=1                 # verbose [timing]/[pipeline] logs (default off)
# MEDIA_WS_TOKEN=...      # require ?token= on /ws/media; baked into Telnyx stream_url
# TELNYX_PUBLIC_KEY=...   # base64 Ed25519 key -> enforce webhook signature verification
